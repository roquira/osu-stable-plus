root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Unused usings must be reported for `dotnet format --verify-no-changes` to fail CI.
dotnet_diagnostic.IDE0005.severity = warning

# Generated by NuGet.
[packages.lock.json]
insert_final_newline = unset
