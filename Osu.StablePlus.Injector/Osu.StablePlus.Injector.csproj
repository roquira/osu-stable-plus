<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Build">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ApplicationIcon>stable-plus.ico</ApplicationIcon>
        <AssemblyName>osu-stable-plus</AssemblyName>
        <RootNamespace>Osu.StablePlus.Injector</RootNamespace>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);NU1702</NoWarn> <!-- ProjectReferences used here are expected to not match target framework -->
        <!-- The hook's SevenZip.dll arrives twice (package content and hook output); both are the same file. -->
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
        <None Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
        <None Include="../CREDITS.md" Link="CREDITS.md" CopyToPublishDirectory="PreserveNewest" />
        <PackageReference Include="HoLLy.ManagedInjector" Version="1.0.0"/>
        <PackageReference Include="System.Management" Version="7.0.1"/>
        <ProjectReference Include="../Osu.StablePlus.Hook/Osu.StablePlus.Hook.csproj">
            <SetTargetFramework>TargetFramework=net452</SetTargetFramework>
            <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained</GlobalPropertiesToRemove>
        </ProjectReference>
    </ItemGroup>
    <Target Name="PublishOfficialPerformance" AfterTargets="Publish" Condition="'$(SkipPerformanceEngine)' != 'true'">
        <MSBuild Projects="../Osu.StablePlus.Performance.Engine/Osu.StablePlus.Performance.Engine.csproj" Targets="Publish"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishTrimmed=false;PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'performance'))" />
    </Target>
</Project>
